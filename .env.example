# =====================================================================
# Бигмах (bigmax.uz) — Environment variables template
# Скопируйте в .env и заполните реальными значениями. Не коммитить .env.
# =====================================================================

# --- Node / App ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- SEO ---
# Канонический хост сайта. Используется для metadataBase, hreflang, sitemap.xml,
# robots.txt, JSON-LD. В prod — https://bigmax.uz. Для staging/preview задаётся
# индивидуально. Если не задан, используется BRAND.url из @bigmax/shared-types.
NEXT_PUBLIC_SITE_URL=http://localhost:3030

# --- Yandex Maps JS API v3 (admin → branches → location picker) ---
# Получить ключ: https://developer.tech.yandex.ru/services/ → "JavaScript API
# и HTTP Геокодер". Бесплатный tier — 25 000 загрузок карты/сутки. Этот ключ
# попадает в клиентский bundle (NEXT_PUBLIC_*), поэтому ограничьте его в
# консоли Yandex по HTTP Referer (домены bigmax.uz / localhost).
# Если переменная не задана — admin-форма филиалов автоматически использует
# Leaflet-fallback (Esri/Carto/OSM-tiles), функционал не теряется.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://bigmax:bigmax@localhost:5432/bigmax

# --- Redis (cache + BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- NextAuth.js (Auth.js v5) ---
# AUTH_SECRET — v5 имя переменной (NEXTAUTH_SECRET тоже поддерживается).
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET=change-me-in-production-use-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production-use-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# --- S3 / MinIO (медиа, bucket: bigmax-media) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=bigmax
S3_SECRET_KEY=bigmax-secret-change-me
S3_BUCKET=bigmax-media
S3_PUBLIC_URL=http://localhost:9000/bigmax-media

# --- Cloudinary (resize / WebP) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Eskiz.uz (SMS / OTP; sender name: BIGMAX) ---
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=BIGMAX

# --- Telegram (канал @bigmax_uz, бот @bigmax_shop_bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ADMIN_CHAT_ID=
# Telegram Login Widget — bot username (без @). Тот же бот, что и
# TELEGRAM_BOT_TOKEN. Ключевое: в @BotFather → /setdomain нужно прописать
# домен сайта (bigmax.uz / staging.bigmax.uz / localhost для dev), иначе
# виджет откажется отрисоваться. NEXT_PUBLIC_* — попадает в client bundle.
# Если пусто — кнопка "Войти через Telegram" просто не показывается.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# --- Resend (email, домен bigmax.uz) ---
RESEND_API_KEY=
RESEND_FROM=orders@bigmax.uz

# --- Uniteller (единственный онлайн-эквайер) ---
# Серверные секреты — никогда не экспонировать в клиент / NEXT_PUBLIC_*.
# В dev/e2e используются безопасные placeholder'ы; в prod — реальные
# значения из ЛК Uniteller (https://lk.uniteller.ru/).
UNITELLER_SHOP_ID=BGX_TEST_SHOP
UNITELLER_PASSWORD=bigmax-dev-placeholder-change-in-prod
UNITELLER_AUTH_LOGIN=bgx_test_auth
UNITELLER_AUTH_PASSWORD=bgx_test_auth_pwd
UNITELLER_CALLBACK_SECRET=bgx-dev-callback-secret
UNITELLER_MODE=test

# --- Loyalty / «Бигмах Бонус» (P7-T2 sub-task C) ---
# Процент начисления баллов от суммы заказа. По умолчанию 1% (1 балл = 1 сум).
# Допустимый диапазон [0.01..50]; вне диапазона / невалидные значения → 1.
# Меняется для маркетинговых акций («увеличенный кэшбэк на выходных»).
# Для permanent изменения структуры лояльности — через P7-T2 follow-up.
LOYALTY_EARN_PERCENT=1

# --- Sentry / Observability ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Meilisearch (поиск с автодополнением) ---
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=bigmax-master-key-change-me
