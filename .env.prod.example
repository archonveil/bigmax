# =====================================================================
# Production env template. Скопируй в `.env.prod` (НЕ commit'ится, см.
# .gitignore), подставь реальные значения. Read by docker-compose.prod.yml
# через `env_file:` и через `${VAR}` interpolation в самом compose-файле.
# =====================================================================

# ----- Build / Node -----
NODE_ENV=production

# ----- Domain / public URLs -----
NEXT_PUBLIC_SITE_URL=https://domtextile.uz
NEXTAUTH_URL=https://domtextile.uz
AUTH_URL=https://domtextile.uz
APP_URL=https://domtextile.uz
DOMAIN=domtextile.uz
ACME_EMAIL=admin@domtextile.uz

# ----- Database (Postgres внутри docker-сети) -----
# POSTGRES_PASSWORD используется compose'ом для инициализации БД +
# generating DATABASE_URL. Generate strong (минимум 32 random char):
#   openssl rand -base64 32
POSTGRES_USER=bigmax
POSTGRES_PASSWORD=__CHANGE_ME_RANDOM_32_CHARS__
POSTGRES_DB=bigmax
# DATABASE_URL не выставляется вручную — compose сам генерит из POSTGRES_*.

# ----- Auth (NextAuth.js v5) -----
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=__CHANGE_ME_RANDOM_32_CHARS__
AUTH_SECRET=__CHANGE_ME_RANDOM_32_CHARS__

# ----- Uniteller (payment gateway) -----
# Production credentials от Uniteller'а. Mock-mode для smoke-test'а:
#   UNITELLER_MODE=mock — webhook'и не отсылаются, всегда returns success.
UNITELLER_MODE=production
UNITELLER_SHOP_ID=__SHOP_ID__
UNITELLER_AUTH_LOGIN=__LOGIN__
UNITELLER_AUTH_PASSWORD=__PASSWORD__
UNITELLER_PASSWORD=__SIGNATURE_KEY__
UNITELLER_CALLBACK_SECRET=__CALLBACK_SECRET__

# ----- Telegram (admin notifications + OTP) -----
TELEGRAM_BOT_TOKEN=__BOT_TOKEN__
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=__BOT_USERNAME__
TELEGRAM_ADMIN_CHAT_ID=__CHAT_ID__
TELEGRAM_CHANNEL_ID=__CHANNEL_ID__

# ----- MeiliSearch (если используется — иначе можно убрать) -----
# Если MeiliSearch не разворачиваем — оставь пустым, search-fallback на
# Postgres trigram (catalog/search.ts gracefully degrade'ит).
MEILISEARCH_HOST=
MEILISEARCH_MASTER_KEY=

# ----- Sentry (optional, error tracking) -----
SENTRY_DSN=
