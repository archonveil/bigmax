# =====================================================================
# Caddy reverse-proxy для domtextile.uz.
#
# Auto-TLS: Caddy сам получает и продлевает Let's Encrypt сертификаты.
# ОБЯЗАТЕЛЬНО: DNS A-запись domtextile.uz → IP сервера ДО запуска
# Caddy'я, иначе ACME-challenge упадёт. Caddy retry'ит каждые ~5 минут.
# =====================================================================

{
    # Email для Let's Encrypt — для notify'ев о просрочке сертификата.
    # Заменить на реальный admin email перед deploy'ем (env $ACME_EMAIL).
    email {$ACME_EMAIL:admin@domtextile.uz}
}

# Reusable proxy config — keeps the upload fallback handler DRY.
(proxy_to_next) {
    reverse_proxy web:3000 {
        # Передаём оригинальный hostname в Next, чтобы next-intl /
        # absolute-URL helpers видели реальный домен.
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Health-check на 5s timeout — если web упал, Caddy не висит.
        transport http {
            response_header_timeout 30s
        }
    }
}

# Основной домен + www → reverse proxy на web:3000.
domtextile.uz, www.domtextile.uz {
    # Gzip + zstd compression для текстовых ответов.
    encode gzip zstd

    # Uploaded product images: serve directly from the shared volume when
    # the file exists there (fast, immutable cache). Falls back to Next.js
    # so uploads are never broken even if the Caddy container is restarted
    # before the volume mount is active.
    @upload_in_volume {
        path /uploads/*
        file {
            root /srv
        }
    }
    handle @upload_in_volume {
        root * /srv
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }
    # Fallback: file not yet in volume → Next.js serves it from public/.
    handle /uploads/* {
        import proxy_to_next
    }

    handle {
        import proxy_to_next
    }

    # Security headers — baseline для PCI / GDPR-compliant'ого магазина.
    header {
        # HSTS на 1 год + preload. После первого деплоя браузер запомнит.
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
        # Скрываем server-header (не отдаём `Server: Caddy` версию).
        -Server
    }

    # Логи — JSON-формат для structured-parsing'а если подключим Loki/ELK.
    log {
        output stdout
        format json
        level INFO
    }
}

# WWW → apex redirect (если domain'ы выше будут split-handler'ить,
# Caddy v2 автоматически combine'ит обе линии в один site-block — это
# нормально, оба сервают одинаковый контент).
