{
  "name": "@bigmax/web",
  "version": "0.0.0",
  "private": true,
  "description": "Бигмах storefront — Next.js 14 App Router",
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev",
    "build": "next build",
    "start": "dotenv -e ../../.env -- next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
